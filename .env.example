# Пример настроек для docker compose (скопировать в .env и поправить).
# .env в git не попадает. Для обычного запуска можно вообще не создавать.
#
# Порты наружу на этом компьютере (если 8000/8080 заняты — поменять):
# API_PORT=8000
# WEB_PORT=8080
#
# Секрет подписи токенов. Для класса можно оставить значение по умолчанию,
# но лучше своё: сгенерировать, например, командой
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=local-dev-secret
